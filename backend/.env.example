#############################################
# 知识库文件存储
#############################################

# 上传文件、解析文件、临时文件存储目录
KB_STORAGE_ROOT=/data/npcbase/data/kb


#############################################
# MySQL 数据库配置
#############################################

# 数据库连接地址
SPRING_DATASOURCE_URL=jdbc:mysql://npcbase.cloud:3306/npcbase_kb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

# 数据库用户名
SPRING_DATASOURCE_USERNAME=npcbase

# 数据库密码
SPRING_DATASOURCE_PASSWORD=<your-mysql-password>


#############################################
# Redis 配置
#############################################

# Redis 服务地址
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<your-redis-password>


#############################################
# Qdrant 向量数据库配置
#############################################

# Qdrant 服务访问地址
KB_QDRANT_URL=https://qdrant.npcbase.cloud

# Qdrant API Key
KB_QDRANT_API_KEY=<your-qdrant-api-key>

# 向量集合名称
KB_QDRANT_COLLECTION=npcbase_bge_m3


#############################################
# 大语言模型 Chat 配置（多提供商可切换）
#
# 用于：
# - RAG 检索结果总结
# - 用户问题理解
# - 最终答案生成
#############################################

# 当前激活的对话模型提供商（deepseek / zhipu）
KB_CHAT_ACTIVE=zhipu

# ---- DeepSeek ----
KB_CHAT_PROVIDERS_DEEPSEEK_ENABLED=true
KB_CHAT_PROVIDERS_DEEPSEEK_BASE_URL=https://api.deepseek.com
KB_CHAT_PROVIDERS_DEEPSEEK_API_KEY=<your-deepseek-api-key>
KB_CHAT_PROVIDERS_DEEPSEEK_MODEL=deepseek-chat

# ---- 智谱 BigModel ----
# 获取免费 API Key：https://bigmodel.cn/  → 控制台 → API Keys
KB_CHAT_PROVIDERS_ZHIPU_ENABLED=true
KB_CHAT_PROVIDERS_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KB_CHAT_PROVIDERS_ZHIPU_API_KEY=<your-zhipu-api-key>
KB_CHAT_PROVIDERS_ZHIPU_MODEL=glm-4-flash


#############################################
# Embedding 向量模型配置
#
# 用于：
# - 文档切片向量化
# - 用户问题向量化
# - Qdrant 相似度检索
#############################################

# 是否开启向量生成
KB_EMBEDDING_ENABLED=true

# SiliconFlow Embedding 服务地址
KB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# SiliconFlow API Key
KB_EMBEDDING_API_KEY=<your-siliconflow-api-key>

# Embedding 模型
KB_EMBEDDING_MODEL=BAAI/bge-m3

# 单批次向量生成数量
KB_EMBEDDING_BATCH_SIZE=16


#############################################
# Rerank 重排序配置
#
# 用于：
# - 对 Qdrant 初步召回结果重新排序
# - 提升检索准确率
#############################################

# 是否开启 Rerank
KB_RERANK_ENABLED=true

# Rerank 模型
KB_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 最终保留结果数量
KB_RERANK_TOP_N=3

#############################################
# 公开体验与唯一密钥访问控制
#############################################

# 使用 PBKDF2WithHmacSHA256 生成，格式：pbkdf2$迭代次数$salt$hash
KB_ACCESS_KEY_HASH=<your-pbkdf2-access-key-hash>

# 至少 32 字节随机内容，用于签名 HttpOnly 访问凭证
KB_ACCESS_TOKEN_SECRET=<your-random-token-secret>

# 预先创建的唯一公开测试会话 ID，不需要修改数据库结构
KB_PUBLIC_DEMO_CONVERSATION_ID=<your-demo-conversation-id>

# 游客固定使用智谱，单访客最多成功提问 5 次
KB_PUBLIC_PROVIDER=zhipu
KB_PUBLIC_MESSAGE_LIMIT=5

# 防止清 Cookie 或并发刷模型的网络与全站每日上限
KB_PUBLIC_IP_DAILY_LIMIT=20
KB_PUBLIC_GLOBAL_DAILY_LIMIT=100

# 解锁凭证和错误密钥尝试限制
KB_ACCESS_TOKEN_TTL_HOURS=24
KB_ACCESS_UNLOCK_MAX_ATTEMPTS=5
KB_ACCESS_UNLOCK_WINDOW_MINUTES=10

# 仅当可信反向代理会覆盖 X-Forwarded-For 时开启
KB_ACCESS_TRUST_FORWARDED_FOR=false

# 本地 HTTP 使用 false；线上 HTTPS 必须设置为 true
KB_ACCESS_COOKIE_SECURE=false
